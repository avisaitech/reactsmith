{
  "name": "@avistech/reactsmith",
  "version": "1.0.0",
  "description": "Forge React 19 components with tests from your terminal. Zero dependencies.",
  "type": "module",
  "bin": {
    "reactsmith": "./bin/cli.js",
    "rcc": "./bin/cli.js"
  },
  "files": [
    "bin",
    "templates"
  ],
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avistech/reactsmith.git"
  },
  "homepage": "https://github.com/avistech/reactsmith#readme",
  "bugs": {
    "url": "https://github.com/avistech/reactsmith/issues"
  },
  "author": "avistech",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "react19",
    "component",
    "generator",
    "scaffold",
    "cli",
    "vitest",
    "jest",
    "testing-library",
    "typescript"
  ]
}
